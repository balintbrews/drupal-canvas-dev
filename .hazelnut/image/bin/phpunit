#!/bin/bash

set -euo pipefail

WORKSPACE_ROOT="${HAZELNUT_WORKSPACE_DIR:-$HOME/workspace}"
ENV_ROOT="${CANVAS_ENV_ROOT:-$WORKSPACE_ROOT/drupal}"
DRUPAL_ROOT="$ENV_ROOT/web"

cd "$DRUPAL_ROOT"

if (( $# == 0 )); then
  exec "$ENV_ROOT/vendor/bin/phpunit" \
    -c core/phpunit.xml.dist \
    modules/contrib/canvas
fi

TARGETS=()
for target in "$@"; do
  if [[ "$target" == -* || "$target" == /* ]]; then
    TARGETS+=("$target")
  else
    TARGETS+=("modules/contrib/canvas/$target")
  fi
done

exec "$ENV_ROOT/vendor/bin/phpunit" -c core/phpunit.xml.dist "${TARGETS[@]}"
