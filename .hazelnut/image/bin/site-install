#!/bin/bash

set -euo pipefail

WORKSPACE_ROOT="${HAZELNUT_WORKSPACE_DIR:-$HOME/workspace}"
ENV_ROOT="${CANVAS_ENV_ROOT:-$WORKSPACE_ROOT/drupal}"
CANVAS_ROOT="${CANVAS_ROOT:-$WORKSPACE_ROOT/${HAZELNUT_PROJECT_NAME:?HAZELNUT_PROJECT_NAME must be set when CANVAS_ROOT is not set}}"
DRUPAL_ROOT="$ENV_ROOT/web"
RECIPE_ROOT="$ENV_ROOT/recipes"
DRUSH="$ENV_ROOT/vendor/bin/drush"

UI=false
MERCURY=false
STARK=false
for arg in "$@"; do
  case "$arg" in
    --ui)
      UI=true
      ;;
    --mercury|-m)
      MERCURY=true
      ;;
    --stark)
      STARK=true
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Usage: site-install [--ui] [-m|--mercury] [--stark]" >&2
      exit 1
      ;;
  esac
done

if [[ ! -x "$DRUSH" ]]; then
  echo "Drush is not installed. Run composer install in $ENV_ROOT first." >&2
  exit 1
fi
if [[ ! -d "$CANVAS_ROOT" ]]; then
  echo "Canvas is not available at $CANVAS_ROOT." >&2
  exit 1
fi

canvas-env-init

CANVAS_BRANCH="$(git -C "$CANVAS_ROOT" symbolic-ref --short HEAD 2>/dev/null || git -C "$CANVAS_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"

drush() {
  "$DRUSH" --root="$DRUPAL_ROOT" --uri="${DRUSH_OPTIONS_URI:-http://127.0.0.1:8080}" "$@"
}

apply_recipe() {
  (cd "$DRUPAL_ROOT" && php core/scripts/drupal recipe --no-interaction "$1")
}

delete_canvas_folders() {
  drush php:eval '
    $storage = \Drupal::entityTypeManager()->getStorage("folder");
    $storage->delete($storage->loadMultiple());
  '
}

rm -rf \
  "$DRUPAL_ROOT/sites/default/files/astro-island" \
  "$DRUPAL_ROOT/sites/default/files/canvas" \
  "$DRUPAL_ROOT/sites/default/files/css" \
  "$DRUPAL_ROOT/sites/default/files/js" \
  "$DRUPAL_ROOT/sites/default/files/php" \
  "$DRUPAL_ROOT/sites/default/files/styles"

drush site-install \
  --account-pass=admin \
  --site-name="Canvas [$CANVAS_BRANCH]" \
  --yes

if drush pm:list --type=module --status=enabled --field=name | grep -qx automated_cron; then
  drush config:set --yes automated_cron.settings interval 0
fi

MODULES=(canvas canvas_headless canvas_dev_mode config default_content jsonapi jsonapi_menu_items admin_toolbar)
if [[ "$UI" == true ]]; then
  MODULES+=(canvas_vite)
fi
drush pm:enable --yes "${MODULES[@]}"

apply_recipe "$RECIPE_ROOT/canvas_dev_oauth"
drush cache:rebuild

if [[ "$MERCURY" == false ]]; then
  if [[ "$STARK" == false ]]; then
    apply_recipe "$RECIPE_ROOT/canvas_dev_humanify"
  else
    apply_recipe "$RECIPE_ROOT/canvas_dev_stark"
  fi
  delete_canvas_folders
else
  apply_recipe "$RECIPE_ROOT/canvas_dev_mercury"
fi

drush cache:rebuild

drush simple-oauth:generate-keys "$DRUPAL_ROOT/sites/default/files"
drush php:eval '
  $consumer = \Drupal::service("entity_type.manager")->getStorage("consumer")->loadByProperties(["client_id" => "cli"]);
  $entity = reset($consumer);
  $entity->set("secret", "secret");
  $entity->save();
'

# npm must run from inside the workspace root: `npm --prefix` through the
# workspace symlink breaks npm's workspace resolution and prunes packages.
if [[ "$UI" == false ]]; then
  (cd "$CANVAS_ROOT" && npm install)
  (cd "$CANVAS_ROOT/ui" && npm run build)
fi
