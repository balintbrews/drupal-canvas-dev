#!/bin/bash

set -euo pipefail

WORKSPACE_ROOT="${HAZELNUT_WORKSPACE_DIR:-$HOME/workspace}"
ENV_ROOT="${CANVAS_ENV_ROOT:-$WORKSPACE_ROOT/drupal}"

canvas-env-init

if (( $# > 0 )); then
  exec "$@"
fi

if [[ ! -f "$ENV_ROOT/web/.ht.router.php" ]]; then
  echo "Drupal is not installed. Run composer install in $ENV_ROOT first." >&2
  exit 1
fi

exec php -S "0.0.0.0:${CANVAS_HTTP_PORT:-8080}" \
  -t "$ENV_ROOT/web" \
  "$ENV_ROOT/web/.ht.router.php"
